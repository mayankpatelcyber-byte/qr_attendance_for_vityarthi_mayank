"""
Attendance app.
Run with:  streamlit run app.py --server.port 5000

Two views, selected by URL query param:
  ?view=mobile  -> phone check-in form (this is what the QR code opens)
  ?view=screen  -> big display for the classroom projector

Run setup_data.py once first to create students.csv and the QR image.
"""

import json
import os

import pandas as pd
import streamlit as st

st.set_page_config(page_title="Attendance System", layout="centered")

CSV_FILE = "students.csv"
SCAN_FILE = "latest_scan.json"
QR_IMAGE = "static/attendance_qr.png"

view = st.query_params.get("view", "mobile")


# ---------- data helpers ----------

def load_students() -> pd.DataFrame:
    return pd.read_csv(CSV_FILE, dtype={"phone_number": str})


def save_students(df: pd.DataFrame) -> None:
    df.to_csv(CSV_FILE, index=False)


def write_scan_result(data: dict) -> None:
    with open(SCAN_FILE, "w") as f:
        json.dump(data, f)


def read_scan_result() -> dict | None:
    if os.path.exists(SCAN_FILE):
        with open(SCAN_FILE, "r") as f:
            return json.load(f)
    return None


# ---------- views ----------

def render_screen_view() -> None:
    st.title("Classroom Attendance System")
    st.subheader("Live Verification Display")

    if os.path.exists(QR_IMAGE):
        st.image(QR_IMAGE, caption="Scan with your phone to mark attendance", width=260)

    st.divider()

    latest = read_scan_result()

    if latest is None:
        st.info("System ready — waiting for the next scan...")
    else:
        status = latest.get("status")

        if status == "success":
            st.success("Attendance Verified Successfully!")
            col1, col2, col3 = st.columns(3)
            col1.metric("Student Name", latest.get("name"))
            col2.metric("Registration No.", latest.get("reg_no"))
            col3.metric("Mobile Number", latest.get("phone_number"))

        elif status == "already_marked":
            st.warning("Notice: Already Marked Present Today")
            col1, col2 = st.columns(2)
            col1.metric("Student Name", latest.get("name"))
            col2.metric("Registration No.", latest.get("reg_no"))

        else:  # "error"
            st.error("Access Denied: Unregistered Phone Number")
            st.write(f"**Submitted mobile:** {latest.get('phone_number')}")
            st.warning("This number is not registered in college records.")

    # Auto-refresh the screen every 2 seconds so it stays live.
    st.markdown('<meta http-equiv="refresh" content="2">', unsafe_allow_html=True)


def render_mobile_view() -> None:
    st.title("Student Attendance Portal")
    st.write("Enter your 10-digit registered mobile number below:")

    user_phone = st.text_input("Registered Mobile Number", placeholder="e.g. 9876500001")

    if not st.button("Submit Attendance", type="primary"):
        return

    phone_str = user_phone.strip()
    if not phone_str:
        st.warning("Please enter a valid phone number.")
        return

    df = load_students()
    match = df[df["phone_number"] == phone_str]

    if match.empty:
        write_scan_result(
            {"status": "error", "name": "N/A", "reg_no": "N/A", "phone_number": phone_str}
        )
        st.error("Error: this phone number is not found in college records!")
        return

    idx = match.index[0]
    student = df.loc[idx]

    if student["status"] == "Present":
        write_scan_result(
            {
                "status": "already_marked",
                "name": student["name"],
                "reg_no": student["reg_no"],
                "phone_number": student["phone_number"],
            }
        )
        st.warning("Notice: you have already been marked Present today.")
        return

    # Mark the student present and persist it.
    df.loc[idx, "status"] = "Present"
    save_students(df)

    write_scan_result(
        {
            "status": "success",
            "name": student["name"],
            "reg_no": student["reg_no"],
            "phone_number": student["phone_number"],
        }
    )
    st.success(f"Attendance marked for {student['name']}!")


# ---------- entry point ----------

if view == "screen":
    render_screen_view()
else:
    render_mobile_view()
